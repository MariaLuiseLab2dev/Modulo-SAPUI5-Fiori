<mvc:View controllerName="studies.firstui5project.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page id="_IDpage" title="Lab2Store" class="sapUiContentPadding">
        <IconTabBar select=".onTabSelect">
            <items>
                <IconTabFilter key="orders" icon="sap-icon://cart" text="Pedidos">
                    <VBox id="ordersContent"/>
                </IconTabFilter>
                <IconTabFilter key="products" icon="sap-icon://product" text="Produtos">
                    <VBox id="productsContent"/>
                </IconTabFilter>
                
                <IconTabFilter key="categories" icon="sap-icon://notes" text="Categorias">
                    <VBox id="categoriesContent"/>
                </IconTabFilter>

                <IconTabFilter key="clients" icon="sap-icon://customer" text="Clientes">
                    <VBox id="clientsContent"/>
                </IconTabFilter>
            </items>
        </IconTabBar>
    </Page>
</mvc:View>