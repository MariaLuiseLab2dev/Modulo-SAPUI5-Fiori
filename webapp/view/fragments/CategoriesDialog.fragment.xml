<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core" >
    <Dialog id="_IDcategoryDialog" title="Detalhes da Categoria" contentWidth="400px" contentHeight="auto">
            <VBox class="sapUiSmallMargin">
                <Label id="_IDlabelNomeDialog" text="Nome" labelFor="_IDinputNomeDialog" />
                <Input id="_IDinputNomeDialog" placeholder="Digite o nome da categoria" width="100%"/>
            </VBox>
            <VBox class="sapUiSmallMargin">
                <Button text="Salvar" press=".onSaveCategory" />
                <Button text="Excluir" press=".onDeleteCategory" />
                <Button text="Fechar" press=".onCloseDialogPress" />
            </VBox>
        </Dialog>
</core:FragmentDefinition>